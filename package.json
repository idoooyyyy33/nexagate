{
  "name": "rfid-lock-manager",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace server run build && npm --workspace web run build",
    "start": "npm --workspace server run start",
    "test": "npm --workspace server test",
    "simulator": "npm --workspace server run simulator"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9",
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9"
  }
}
